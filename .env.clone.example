# =============================================================================
# WATCH & EARN INDEPENDENT CLONE - ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT:
# 1. Never commit your production credentials or real bot tokens to GitHub.
# 2. This clone MUST use its own dedicated Bot Token from @BotFather.
# 3. This clone MUST use an isolated database namespace or separate project.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TELEGRAM BOT CREDENTIALS (NEW BOT FROM @BotFather)
# -----------------------------------------------------------------------------
# Create a NEW bot using @BotFather on Telegram:
# Command: /newbot -> Enter a name -> Enter a unique username ending in 'bot'
# Copy the token below:
TELEGRAM_BOT_TOKEN="YOUR_NEW_BOT_TOKEN_FROM_BOTFATHER"
TELEGRAM_BOT_USERNAME="YourNewCloneBot"

# -----------------------------------------------------------------------------
# 2. AUTHORIZED ADMIN TELEGRAM USER IDS
# -----------------------------------------------------------------------------
# Comma-separated numeric Telegram User IDs authorized to access the Admin Panel
# and receive administrative notifications.
# Obtain your ID by sending /start to @userinfobot or checking the WebApp.
ADMIN_TELEGRAM_IDS="2022247489"

# -----------------------------------------------------------------------------
# 3. PUBLIC APP URL & WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
# The public HTTPS domain where THIS CLONE is deployed (e.g. Render, Vercel, VPS).
# Used for Telegram Mini App URL and Bot Webhook callbacks.
# NEVER point this to the original bot's domain!
APP_URL="https://your-clone-deployment-domain.com"

# Unique random secret token for verifying Telegram Webhook requests (Optional but recommended)
WEBHOOK_SECRET="generate_a_random_32_character_secret_here"

# Server Port (use 3001 or any non-conflicting port for local running)
PORT=3001
NODE_ENV=production

# -----------------------------------------------------------------------------
# 4. STRICT DATABASE ISOLATION CONFIGURATION
# -----------------------------------------------------------------------------
# To guarantee 100% isolation from the original bot and production database,
# you have three flexible isolation options:
#
# OPTION A: Namespace Isolation (Recommended if using the same Firebase project)
# Prefixes every collection (e.g. clone_users, clone_tasks, clone_transactions, etc.)
# so it is technically impossible to access or modify the original bot's data.
DB_PREFIX="clone"

# OPTION B: Dedicated Firestore Named Database (Same Google Cloud project)
# In Firebase/GCP Console -> Firestore Database -> Create Database -> 'clone-db'
# FIRESTORE_DATABASE_ID="clone-db"

# OPTION C: Completely Separate Firebase Project
# If you created a brand new Firebase project for this clone, enter its config:
# FIREBASE_PROJECT_ID="your-separate-firebase-project"
# FIREBASE_API_KEY="AIzaSy..."
# FIREBASE_AUTH_DOMAIN="your-separate-firebase-project.firebaseapp.com"
# FIREBASE_STORAGE_BUCKET="your-separate-firebase-project.firebasestorage.app"
# FIREBASE_MESSAGING_SENDER_ID="123456789012"
# FIREBASE_APP_ID="1:123456789012:web:abcdef..."

# OPTION D: Separate Supabase Project (If utilizing PostgreSQL RPC / Gift card engine)
# SUPABASE_URL="https://your-separate-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# 5. PAYOUT GATEWAY CONFIGURATION (SAFE BY DEFAULT)
# -----------------------------------------------------------------------------
# Keeps payouts in simulated sandbox mode until live credentials are confirmed.
PAYOUT_LIVE_ENABLED="false"
PAYOUT_PROVIDER="sandbox"
PAYOUT_API_KEY=""
PAYOUT_API_SECRET=""
PAYOUT_MERCHANT_ID=""
