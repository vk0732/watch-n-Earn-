# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_BOT_USERNAME="YourEarnBot"

# Authorized Telegram User IDs for Admin Panel access (comma-separated numeric IDs)
# Obtain your Telegram ID from @userinfobot or Telegram WebApp
ADMIN_TELEGRAM_IDS="504198372,123456789"

# Public URL of the deployed application (used for Webhook & Mini App URL)
# Example: https://your-domain.com or Cloud Run URL
APP_URL="https://your-domain.com"

# Webhook Secret Token for Telegram Webhook security
WEBHOOK_SECRET="random_secure_token_12345"

# UPI Payout Gateway Configuration (SAFE: DISABLED BY DEFAULT)
# Keep false until provider credentials are tested and approved
PAYOUT_LIVE_ENABLED="false"
PAYOUT_PROVIDER="sandbox"
PAYOUT_API_KEY="your_payout_api_key"
PAYOUT_API_SECRET="your_payout_secret_key"
PAYOUT_MERCHANT_ID="your_merchant_id"
